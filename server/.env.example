# Backend environment example (VYRO VX7 — Smart Business POS API)
# No MongoDB anymore — server.py talks straight to Firestore via firestore_db.py.
JWT_SECRET=oOWCz2CQ13M9K15cRleoAa76Rec7K9YMJivLrcF5c49pmy07JCj1zrnbgdwsZh_O
ADMIN_EMAIL=aryanrana2064@gmail.com 
ADMIN_PASSWORD=aryanrana2064@gmail.com
CORS_ORIGINS=*

# Firebase project ID (Google Sign-In + Firestore). Must match
# REACT_APP_FIREBASE_PROJECT_ID in the frontend .env.
# Firebase Console -> Project settings -> General -> Project ID.
FIREBASE_PROJECT_ID=vxro-vx7

# REQUIRED on Vercel (unlike `firebase deploy`, Vercel has no ambient GCP
# credentials, so the Admin SDK needs a service account explicitly):
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key -> paste the ENTIRE downloaded JSON file as ONE line here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"vxro-vx7", ...}


